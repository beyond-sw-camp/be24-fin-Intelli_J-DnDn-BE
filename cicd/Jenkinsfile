pipeline {
  agent {
    kubernetes {
      namespace 'default'
      label "gradle-kaniko-${UUID.randomUUID().toString()}"
      defaultContainer 'gradle'
      yaml """
apiVersion: v1
kind: Pod
spec:
  restartPolicy: Never
  containers:
    - name: gradle
      image: gradle:8.9-jdk17
      command: ['cat']
      tty: true
      volumeMounts:
        - name: gradle-cache
          mountPath: /home/gradle/.gradle
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ['/busybox/sh','-c','sleep infinity']
      tty: true
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker
        - name: workspace
          mountPath: /workspace
    - name: kubectl
      image: bitnami/kubectl:latest
      command: ['sleep', 'infinity']
      securityContext:
        runAsUser: 0
  volumes:
    - name: gradle-cache
      emptyDir: {}
    - name: workspace
      emptyDir: {}
    - name: docker-config
      secret:
        secretName: dockerhub-cred
        items:
          - key: .dockerconfigjson
            path: config.json
"""
    }
  }

  environment {
    IMAGE_NAME = 'seungwoo0128/dndn-backend'
    IMAGE_TAG  = "1.${env.BUILD_NUMBER}"
  }
  stages {
    stage('Checkout') {
      steps {
        container('gradle') {
          checkout([$class: 'GitSCM',
            branches: [[name: '*/main']],
            userRemoteConfigs: [[url: 'https://github.com/beyond-sw-camp/be24-fin-Intelli_J-DnDn-BE.git']]
          ])
        }
      }
    }

    stage('Gradle Build') {
      steps {
        container('gradle') {
          sh '''
            chmod +x ./gradlew || true
            ./gradlew --no-daemon clean bootJar
          '''
        }
      }
    }

    stage('Kaniko Build & Push') {
      steps {
        container('kaniko') {
          sh """
            /kaniko/executor \
              --context=${WORKSPACE} \
              --dockerfile=${WORKSPACE}/Dockerfile \
              --destination=${IMAGE_NAME}:${IMAGE_TAG} \
              --destination=${IMAGE_NAME}:latest \
              --single-snapshot \
              --use-new-run \
              --cache=true \
              --snapshotMode=redo
          """
        }
      }
    }

    stage('Result') {
      steps {
        echo "Pushed: ${IMAGE_NAME}:${IMAGE_TAG}"
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        container('kubectl') {
          script {
            def activeService = sh(
              script: "kubectl get ingress backend-ingress -o jsonpath='{.spec.rules[0].http.paths[0].backend.service.name}'",
              returnStdout: true
            ).trim()
            def activeVersion   = activeService.contains('blue') ? 'blue' : 'green'
            def inactiveVersion = activeVersion == 'blue' ? 'green' : 'blue'
            echo "Active: ${activeVersion} → Deploying to: ${inactiveVersion}"

            sh "kubectl set image deployment/dndn-backend-${inactiveVersion} backend=${IMAGE_NAME}:${IMAGE_TAG}"
            sh "kubectl scale deployment/dndn-backend-${inactiveVersion} --replicas=2"
            sh "kubectl rollout status deployment/dndn-backend-${inactiveVersion} --timeout=180s"

            // Ingress 전환 (외부 트래픽)
            sh """
              kubectl patch ingress backend-ingress --type=json \
                -p='[{"op":"replace","path":"/spec/rules/0/http/paths/0/backend/service/name","value":"backend-service-${inactiveVersion}"}]'
            """

            // stable backend-service selector 전환 (프론트 nginx proxy_pass용)
            sh "kubectl patch svc backend-service -p '{\"spec\":{\"selector\":{\"type\":\"backend\",\"version\":\"${inactiveVersion}\"}}}'"

            sh "kubectl scale deployment/dndn-backend-${activeVersion} --replicas=0"
            echo "Switched to: ${inactiveVersion}"
          }
        }
      }
    }
  }
}